<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bassel AI - الأرشيف والمنسق الذكي"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الحالة: جاهز"
        android:textSize="14sp"
        android:textColor="#03DAC5"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/inputRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اكتب طلبك أو فكرتك هنا..."
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:backgroundTint="#03DAC5"
        android:minHeight="48dp"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تحليل وتنفيذ عبر Bassel AI"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ستظهر نتائج التحليل وخطط العمل هنا..."
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:padding="8dp" />
    </ScrollView>

</LinearLayout>